        <mxCell id="e3" edge="1" parent="1" source="driver" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;fontSize=10;exitX=1;exitY=0.8;entryX=0;entryY=0.1;" target="evbat" value="ΔSOC_drive (on arrival)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="236" />
              <mxPoint x="870" y="236" />
              <mxPoint x="870" y="594" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontColor=#006600;fontSize=10;exitX=1;exitY=0.5;" value="P_hp [W]">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="440" as="sourcePoint" />
            <mxPoint x="560" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="ctrl" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontColor=#006600;fontSize=10;" target="hp" value="P_hp [W]">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="hp" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontColor=#006600;fontSize=10;" target="room" value="Q_hp [W]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="room" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#001a99;strokeWidth=2;fontColor=#001a99;fontSize=10;dashed=1;exitX=0;exitY=0.3;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="ctrl" value="T_room [°C]">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="160" y="710" />
              <mxPoint x="100" y="710" />
              <mxPoint x="100" y="410" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="grid" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#001a99;strokeWidth=2;fontColor=#001a99;fontSize=10;dashed=1;exitX=0;exitY=0.25;entryX=1;entryY=0.3;exitDx=0;exitDy=0;" target="ctrl" value="V_grid [p.u.]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="grid" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#001a99;strokeWidth=2;fontColor=#001a99;fontSize=10;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" target="chargectrl" value="V_grid [p.u.]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="chargectrl" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;fontSize=10;exitX=0;exitY=0.3;entryX=1;entryY=0.1;" target="grid" value="P_charge [W]&lt;br&gt;(+: charge, −: V2G)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="chargectrl" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;fontSize=10;" target="evbat" value="P_charge [W]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="evbat" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#001a99;strokeWidth=2;fontColor=#001a99;fontSize=10;dashed=1;exitX=1;exitY=0.3;" value="SOC [%]">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1270" y="642" />
              <mxPoint x="1270" y="476" />
              <mxPoint x="1210" y="476" />
            </Array>
            <mxPoint x="1210" y="476" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Legend — Component Colors&lt;/b&gt;&lt;br&gt;&lt;br&gt;🟢 Green: Baseline components (unchanged)&lt;br&gt;🟡 Orange: Modified baseline components for FM-c&lt;br&gt;🔴 Red/Pink: New components added in FM-c&lt;br&gt;&lt;br&gt;&lt;b&gt;Arrow Types&lt;/b&gt;&lt;br&gt;&lt;br&gt;—— Solid green: Baseline data flows&lt;br&gt;—— Solid red: New FM-c signals&lt;br&gt;- - - Blue dashed: Feedback signals (k−1)" vertex="1">
          <mxGeometry height="200" width="340" x="160" y="830" as="geometry" />
        </mxCell>
        <mxCell id="decisions" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Key Design Decisions — FM-c&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Driver Model is event-based; SOC depletion applied as step-change on arrival&lt;br&gt;2. EV charges/discharges ONLY when is_home = True&lt;br&gt;3. Voltage correction has priority over SOC-based charging logic&lt;br&gt;4. V2G discharges during &lt;b&gt;undervoltage&lt;/b&gt; (injects power → raises V);&lt;br&gt;   charges at max during &lt;b&gt;overvoltage&lt;/b&gt; (absorbs power → lowers V)&lt;br&gt;5. SOC_min_V2G = 40% reserves range for next day&#39;s driving&lt;br&gt;6. Asymmetric efficiency: η_ch in numerator, η_dis in denominator&lt;br&gt;7. T_min_dyn: 10°C away (frost protection), 18°C home (comfort)" vertex="1">
          <mxGeometry height="200" width="500" x="560" y="830" as="geometry" />
        </mxCell>
        <mxCell id="syncnote" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Synchronization Order (per timestep k)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Driver Model → is_home[k], T_min_dyn[k], ΔSOC_drive[k]&lt;br&gt;2. Electric Grid → V_grid[k]  (uses P_hp[k−1] + P_charge[k−1])&lt;br&gt;3. Heat Pump → Q_hp[k]  (uses P_hp[k−1])&lt;br&gt;4. Room → T_room[k]  (uses Q_hp[k])&lt;br&gt;5. EV Battery → SOC[k]  (uses P_charge[k−1], ΔSOC_drive[k])&lt;br&gt;6. Thermostat Controller → P_hp[k]  (uses V_grid[k], T_room[k], T_min_dyn[k])&lt;br&gt;7. Charging Controller → P_charge[k]  (uses V_grid[k], SOC[k], is_home[k])" vertex="1">
          <mxGeometry height="200" width="400" x="940" y="830" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
