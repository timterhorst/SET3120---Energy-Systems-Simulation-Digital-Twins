        </mxCell>
        <mxCell id="room" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;strokeWidth=2;" value="&lt;b&gt;Room (Thermal)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Dynamic (ODE)&lt;/i&gt;&lt;br&gt;&lt;br&gt;dT/dt = (1/C)(Q_hp - (T - T_out)/R)&lt;br&gt;&lt;br&gt;State: T_room [°C]&lt;br&gt;C = 7200 kJ/K&lt;br&gt;R = 0.007 K/W" vertex="1">
          <mxGeometry height="160" width="240" x="120" y="600" as="geometry" />
        </mxCell>
        <mxCell id="heatpump" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;strokeWidth=2;" value="&lt;b&gt;Heat Pump&lt;/b&gt;&lt;br&gt;&lt;i&gt;Quasi-static (AE)&lt;/i&gt;&lt;br&gt;&lt;br&gt;Q_hp = COP × P_set&lt;br&gt;&lt;br&gt;COP = 3" vertex="1">
          <mxGeometry height="120" width="240" x="120" y="400" as="geometry" />
        </mxCell>
        <mxCell id="controller" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;strokeWidth=2;" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;i&gt;Quasi-static (logic)&lt;/i&gt;&lt;br&gt;&lt;br&gt;IF V ∉ [0.98, 1.02] OR&lt;br&gt;   T ∉ [18°C, 22°C]&lt;br&gt;THEN P ± 2 kW&lt;br&gt;&lt;br&gt;Voltage priority" vertex="1">
          <mxGeometry height="140" width="240" x="120" y="200" as="geometry" />
        </mxCell>
        <mxCell id="grid" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;strokeWidth=2;fontStyle=1" value="&lt;b&gt;Electric Grid&lt;/b&gt;&lt;br&gt;&lt;i&gt;Quasi-static (AE)&lt;/i&gt;&lt;br&gt;&lt;br&gt;PowerGridModel (AC power flow)&lt;br&gt;&lt;br&gt;• 95-bus distribution network&lt;br&gt;• V_rated = 400 V (L-L)&lt;br&gt;• cosφ = 0.95&lt;br&gt;• Slack bus at node 1&lt;br&gt;&lt;br&gt;Returns: V_smart [p.u.]" vertex="1">
